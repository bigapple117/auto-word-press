# 이 파일을 .env로 복사해서 값을 채웁니다. .env는 Git에 올라가지 않습니다.
# 비어 있는 값은 그 기능을 처음 쓸 때 "넣어 주세요" 안내가 나옵니다.

# 워드프레스: 관리자 화면 > 사용자 > 프로필 > "응용 프로그램 비밀번호"에서 발급
WP_BASE_URL=https://jalcheck.com
WP_USERNAME=
WP_APP_PASSWORD=

# Gemini: https://aistudio.google.com/apikey (무료 등급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 무료 스톡: https://www.pexels.com/api/ , https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 네이버 검색(NAVER API HUB, console.ncloud.com): 웹문서·뉴스·검색어트렌드
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 텔레그램: @BotFather로 봇 만들고 토큰 발급, CHAT_ID는 내 대화방 번호
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 구글 시트: 서비스 계정 JSON 파일 경로(프로젝트 기준 상대 경로 가능)와 시트 ID
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# AI 성우: ko-KR-SunHiNeural(여), ko-KR-InJoonNeural(남), ko-KR-HyunsuMultilingualNeural(남)
TTS_VOICE=ko-KR-SunHiNeural

# 웹 대시보드: 기본은 서버 안에서만 접속
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 경로(보통 비워 둠): 작업 DB·결과물 폴더, FFmpeg, 폰트
DATA_DIR=
FFMPEG_BIN=
FFPROBE_BIN=
FONTS_DIR=
